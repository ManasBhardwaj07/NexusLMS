// 03 — CodeAscend Database Schema (Prisma) v2.0 FINAL
// v2.0 changes: users.dateOfBirth/isMinor/trackingConsent, ParentalConsent table,
// consent-gating support. Everything else identical to v1.0 (which passed review).
// Money is ALWAYS integer paise. All timestamps UTC. Payment tables append-only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  STUDENT
  MENTOR
  ADMIN
}

enum CourseStatus {
  DRAFT
  PUBLISHED
}

enum OrderStatus {
  CREATED
  AUTHORIZED
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum PaymentStatus {
  CREATED
  CAPTURED
  FAILED
  REFUNDED
}

enum EnrollmentStatus {
  ACTIVE
  REFUNDED
  REVOKED
}

enum LiveSessionStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

enum DiscountType {
  PERCENT
  FLAT
}

enum ConsentMethod {
  EMAIL
  PHONE
}

enum ConsentState {
  NOT_REQUIRED
  PENDING
  VERIFIED
}

model User {
  id              String       @id @default(uuid())
  name            String?
  email           String       @unique
  emailVerified   DateTime?
  passwordHash    String?
  phone           String?
  role            Role         @default(STUDENT)
  permissions     Json?
  tokenVersion    Int          @default(0) // bump + DEL Redis key tv:{id} = global revoke
  // --- v2.0: DPDP minors ---
  dateOfBirth     DateTime? // REQUIRED at signup (enforced at API layer)
  isMinor         Boolean      @default(false) // derived at DOB capture (<18); never flipped back by user
  trackingConsent Boolean      @default(false) // GA4/funnel events only if true AND !isMinor
  consentState    ConsentState @default(NOT_REQUIRED)
  consentAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  accounts          Account[]
  coursesCreated    Course[]           @relation("CourseCreator")
  orders            Order[]
  enrollments       Enrollment[]
  progress          LectureProgress[]
  mentorSessions    LiveSession[]      @relation("SessionMentor")
  couponRedemptions CouponRedemption[]
  adminActions      AdminAction[]
  parentalConsent   ParentalConsent?
}

// v2.0: verifiable parental consent (DPDP §9) — auditable evidence
model ParentalConsent {
  id             String        @id @default(uuid())
  userId         String        @unique
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  method         ConsentMethod
  parentEmail    String?
  parentPhone    String?
  tokenHash      String        @unique // SHA-256 hash of single-use token; plaintext only in emailed link (48h life)
  tokenExpiresAt DateTime
  verifiedAt     DateTime?
  ipAddress      String? // evidence
  userAgent      String? // evidence
  createdAt      DateTime      @default(now())
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Course {
  id                 String        @id @default(uuid())
  title              String
  slug               String        @unique
  description        String
  category           String
  level              String
  priceCents         Int
  discountPriceCents Int?
  thumbnailUrl       String?
  status             CourseStatus  @default(DRAFT)
  createdById        String
  createdBy          User          @relation("CourseCreator", fields: [createdById], references: [id])
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  modules            Module[]
  liveSessions       LiveSession[]
  orders             Order[]
  enrollments        Enrollment[]
  coupons            Coupon[]

  @@index([status, category])
}

model Module {
  id       String    @id @default(uuid())
  courseId String
  course   Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title    String
  position Int
  lectures Lecture[]

  @@index([courseId, position])
}

model Lecture {
  id            String            @id @default(uuid())
  moduleId      String
  module        Module            @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  videoProvider String            @default("CLOUDFLARE_STREAM")
  videoUid      String
  durationSec   Int               @default(0)
  isPreview     Boolean           @default(false)
  position      Int
  isPublished   Boolean           @default(true)
  createdAt     DateTime          @default(now())
  progress      LectureProgress[]
  recordedFor   LiveSession?

  @@index([moduleId, position])
}

model LiveSession {
  id                 String            @id @default(uuid())
  courseId           String
  course             Course            @relation(fields: [courseId], references: [id])
  mentorId           String
  mentor             User              @relation("SessionMentor", fields: [mentorId], references: [id])
  title              String
  scheduledAt        DateTime
  status             LiveSessionStatus @default(SCHEDULED)
  provider           String            @default("YOUTUBE")
  streamUrl          String
  recordingLectureId String?           @unique
  recordingLecture   Lecture?          @relation(fields: [recordingLectureId], references: [id])
  createdAt          DateTime          @default(now())

  @@index([courseId, scheduledAt])
}

model Order {
  id              String      @id @default(uuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  courseId        String
  course          Course      @relation(fields: [courseId], references: [id])
  couponId        String?
  coupon          Coupon?     @relation(fields: [couponId], references: [id])
  amountCents     Int
  currency        String      @default("INR")
  status          OrderStatus @default(CREATED)
  idempotencyKey  String?     @unique
  receipt         String
  razorpayOrderId String?     @unique
  expiresAt       DateTime?
  // v2.0 seam: purchaser-of-record fields arrive via migration 0003 ONLY if Wk2 decision requires
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  payments        Payment[]
  enrollment      Enrollment?

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model Payment {
  id                String        @id @default(uuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id])
  razorpayPaymentId String        @unique
  razorpaySignature String?
  method            String?
  amountCents       Int
  status            PaymentStatus
  paidAt            DateTime?
  raw               Json?
  createdAt         DateTime      @default(now())

  @@index([orderId])
}

model Enrollment {
  id         String            @id @default(uuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id])
  courseId   String
  course     Course            @relation(fields: [courseId], references: [id])
  orderId    String            @unique
  order      Order             @relation(fields: [orderId], references: [id])
  status     EnrollmentStatus  @default(ACTIVE)
  enrolledAt DateTime          @default(now())
  revokedAt  DateTime?
  progress   LectureProgress[]
  // Partial unique index (raw SQL): one ACTIVE enrollment per user+course.
}

model LectureProgress {
  id           String     @id @default(uuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lectureId    String
  lecture      Lecture    @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  watchedSec   Int        @default(0)
  completed    Boolean    @default(false)
  updatedAt    DateTime   @updatedAt
  User         User?      @relation(fields: [userId], references: [id])
  userId       String?

  @@unique([enrollmentId, lectureId])
}

model Coupon {
  id           String             @id @default(uuid())
  code         String             @unique
  discountType DiscountType
  value        Int
  courseId     String?
  course       Course?            @relation(fields: [courseId], references: [id])
  validFrom    DateTime
  validTo      DateTime
  maxUses      Int?
  // usedCount is a cached counter only — source of truth is COUNT(CouponRedemption) in a txn.
  // Never use this for maxUses enforcement; read redemption rows in the same txn as the new redemption insert.
  usedCount    Int                @default(0)
  perUserLimit Int                @default(1)
  active       Boolean            @default(true)
  redemptions  CouponRedemption[]
  orders       Order[]
}

model CouponRedemption {
  id        String   @id @default(uuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  orderId   String
  createdAt DateTime @default(now())

  @@index([couponId, userId])
}

model WebhookEvent {
  id              String    @id @default(uuid())
  provider        String
  providerEventId String    @unique
  eventType       String
  payload         Json
  processedAt     DateTime?
  relatedOrderId  String? // FK to Order for fast reconciliation lookups
  createdAt       DateTime  @default(now())
}

enum ActorType {
  ADMIN
  SYSTEM
}

model AdminAction {
  id        String    @id @default(uuid())
  actorType ActorType @default(ADMIN) // SYSTEM for automated jobs (expiry, BullMQ); ADMIN for human mutations
  adminId   String?
  admin     User?     @relation(fields: [adminId], references: [id])
  action    String
  entity    String
  entityId  String
  meta      Json?
  createdAt DateTime  @default(now())

  @@index([entity, entityId])
}
