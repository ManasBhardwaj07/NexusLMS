# Neon Postgres — Pooled (app runtime, used by Prisma Client)
DATABASE_URL="postgresql://USER:PASSWORD@ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Neon Postgres — Direct (migrations only, used by Prisma Migrate)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require"

# NextAuth Secrets
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
AUTH_SECRET=""

# Sentry DSNs for error tracking
SENTRY_DSN_WEB=""
NEXT_PUBLIC_SENTRY_DSN_WEB=""
SENTRY_DSN_API=""

# Internal routing and API
API_INTERNAL_URL="" # internal proxy url for web -> api
PORT="" # api port

# Upstash Redis (Rate limiting)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Analytics (PostHog)
POSTHOG_API_KEY=""
POSTHOG_HOST="https://app.posthog.com"

# Consent / Mailer (Resend)
CONSENT_BASE_URL=""
RESEND_API_KEY=""
EMAIL_FROM=""

# Security
CORS_ORIGIN="" # comma-separated allowed CORS origins (defaults to http://localhost:3000)