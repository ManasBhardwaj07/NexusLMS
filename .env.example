# Neon Postgres — Pooled (app runtime, used by Prisma Client)
DATABASE_URL="postgresql://USER:PASSWORD@ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Neon Postgres — Direct (migrations only, used by Prisma Migrate)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require"

# Sentry DSNs for error tracking
SENTRY_DSN_WEB=""
SENTRY_DSN_API=""
API_INTERNAL_URL="" # internal proxy url for web -> api
RESEND_API_KEY=""
CONSENT_BASE_URL=""