{
  "name": "codeascend-platform",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter web --filter api --parallel dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run --passWithNoTests",
    "boundaries": "depcruise web api packages",
    "toolchain-delta": "node scripts/check-toolchain-delta.js",
    "cleanroom": "node scripts/check-cleanroom.js",
    "gate": "sh scripts/check-file-placement.sh && pnpm cleanroom && pnpm toolchain-delta && node scripts/check-docs.mjs && pnpm lint && pnpm typecheck && pnpm test && pnpm boundaries && pnpm build",
    "postinstall": "prisma generate"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "24"
  },
  "dependencies": {
    "@prisma/client": "5.22.0"
  },
  "devDependencies": {
    "dependency-cruiser": "18.4.0",
    "prisma": "5.22.0",
    "tsx": "4.23.15",
    "vitest": "5.0.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.23"
    }
  }
}
