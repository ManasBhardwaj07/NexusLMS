{
  "name": "codeascend-platform",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter web --filter api --parallel dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "echo \"no test runner configured yet\"",
    "boundaries": "depcruise web api packages",
    "toolchain-delta": "node scripts/check-toolchain-delta.js",
    "postinstall": "prisma generate"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "24"
  },
  "dependencies": {
    "@prisma/client": "5.22.0"
  },
  "devDependencies": {
    "dependency-cruiser": "18.4.0",
    "prisma": "5.22.0",
    "tsx": "4.23.15"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.23"
    }
  }
}
